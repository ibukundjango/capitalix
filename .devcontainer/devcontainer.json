{
  "name": "Capitalix Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/postgres:1": {}
  },
  "forwardPorts": [8000, 5432],
  "postCreateCommand": "pip install -r backend/requirements.txt && python backend/manage.py migrate",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "batisteo.vscode-django",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}